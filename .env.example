# Copy this file to .env and fill in your keys.

# --- Model (any OpenAI-compatible /chat/completions API) ---
# Mistral (default)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-large-latest

# Examples of swapping the model without touching code:
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<model id>

# --- Optional: separate "judge" model ---
# Used for shortlist, scoring, critique and the report (few calls, judgement-heavy).
# Leave empty to use the main model for everything.
# Typical local-first setup: main = Ollama (many cheap research calls), judge = Mistral API.
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=

# Local models are slower; raise if calls time out.
# LLM_TIMEOUT_MS=180000

# --- Web search ---
# tavily | exa | brave | searxng   (setup help for each: in the app, Profile > Models & search)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
# Self-hosted SearXNG (free; needs format=json enabled in its settings.yml)
SEARXNG_URL=http://localhost:8080

# --- Optional limits (defaults shown) ---
# MIN_LONGLIST=6
# MAX_SHORTLIST=5
# Discovery finishes only after this many searches in a row found nothing new (or the longlist reaches MAX_LONGLIST).
# DISCOVER_SATURATION=3
# MAX_LONGLIST=20
# Pause after discovery so you can remove/add products or ask for more searching (0 = skip).
# REVIEW_LONGLIST=1
# MIN_EVIDENCE=6
# MAX_ROUNDS=2
# MAX_FETCHES_PER_TASK=12
# Characters of each web page shown to the model. Research sees the most relevant passages up to this size
# (quotes are still checked against the full page). Lower it to cut cost, raise it if research misses details.
# PAGE_CHARS=3500
# Most questions the interview may ask.
# INTAKE_MAX_QUESTIONS=6
# Products whose article/list price is up to this % over budget are still researched
# (current sale prices are often lower). Only a seller-page price over budget rules a product out.
# PRICE_TO_VERIFY_PERCENT=30
# Carry earlier findings/measurements on a product into new research for N days (0 = off).
# Research still runs every time; prices are never reused.
# CACHE_DAYS=30
# MIN_FRESH_FINDINGS=3
# Share of a criterion score from measurements when found (rest: side-by-side comparison).
# METRIC_WEIGHT=0.7
# Side-by-side comparisons per criterion (median is used), tie margin in points,
# and how close two sources must be for a measurement to count as confirmed.
# JUDGE_SAMPLES=3
# TIE_MARGIN=3
# METRIC_AGREEMENT=0.03
